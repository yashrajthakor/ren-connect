# Dependencies — reinstalled inside the image from the lockfile.
node_modules
**/node_modules

# Build output — regenerated by the build stage.
dist
dist-ssr
build

# VCS / CI
.git
.gitignore
.github

# Local env files: build values come from Docker build args instead, so a
# stray local .env can never leak into or override a production image.
.env
.env.*
!.env.example

# Editor / tooling / agent state
.vscode
.idea
.claude
*.log
npm-debug.log*
.DS_Store

# Alternate lockfiles — the image builds with npm ci + package-lock.json.
bun.lock
bun.lockb
yarn.lock
pnpm-lock.yaml

# Backend-only assets, not needed to build the frontend bundle.
supabase

# Docker files themselves
Dockerfile
.dockerignore
